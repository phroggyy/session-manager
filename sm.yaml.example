# Session Manager Configuration Example
# Copy this file to sm.yaml in your repository root

# Global environment file (applies to all processes)
# Supports .envrc-style files with KEY=value, export KEY=value, quotes, and comments
env_file: .envrc

processes:
  # Web server process
  - name: web-server
    command: make run
    cwd: ./server
    env:
      PORT: "8080"
      DEBUG: "true"

  # Frontend development server
  - name: frontend
    command: npm run dev
    cwd: ./frontend
    # Process-specific env_file (overrides global, overridden by inline env)
    env_file: ./frontend/.env
    env:
      VITE_API_URL: http://localhost:8080

  # Database watcher (optional)
  # - name: db-migrate
  #   command: make watch-migrations
  #   cwd: ./db

  # Background worker (optional)
  # - name: worker
  #   command: go run ./cmd/worker
  #   cwd: .
  #   env:
  #     WORKER_CONCURRENCY: "4"
